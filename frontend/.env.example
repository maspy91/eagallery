# frontend/.env.example
# EDITED FILE — replaces: .env.example (whole-file replacement)
# Added the PUBLIC_TURNSTILE_SITE_KEY section at the bottom.

# Local dev — points at your local backend or the deployed Render backend
PUBLIC_API_URL=http://localhost:8000

# Staging (optional, once you set up the fixed Vercel alias)
# PUBLIC_API_URL=https://api-staging.yourdomain.com

# Production
# PUBLIC_API_URL=https://api.yourdomain.com

# Cloudflare Turnstile site key (public, safe to expose client-side --
# this is NOT the secret key, that lives only in the backend's .env as
# TURNSTILE_SECRET). Leave empty/unset to keep Turnstile off: the widget
# renders nothing and every form submits exactly as it does today.
# Get this from the Cloudflare dashboard -- Turnstile -- your site --
# it's the "Site Key", paired with a "Secret Key" for the backend.
# Must ALSO be declared here (even blank) or the build fails, since
PUBLIC_TURNSTILE_SITE_KEY=
# Public opt-in flag to enable Turnstile in the shipped client. Set to
# the string "true" to enable. Leave blank or set to anything else to
# keep Turnstile disabled client-side.
PUBLIC_TURNSTILE_ENABLED=false
# api.ts/these pages import it via $env/static/public, which requires
# every PUBLIC_ var it uses to exist in .env at build time.
PUBLIC_TURNSTILE_SITE_KEY=
