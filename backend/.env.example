APP_NAME=EddyArt Gallery
DEBUG=True
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.neon.tech/dbname?ssl=require
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The frontend calls this backend's Render URL directly (see frontend's
# PUBLIC_API_URL) -- that's cross-site, so production needs SameSite=none
# (the default). Locally, both sides run on http://localhost, so it's
# overridden to "lax" here -- SameSite=none cookies require Secure=True,
# which browsers refuse to send over plain http.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=True

TURNSTILE_ENABLED=False
TURNSTILE_SECRET=your_cloudflare_turnstile_secret

EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=noreply@eddyartgallery.app
SMTP_FROM_NAME=EddyArt Gallery
SMTP_USE_TLS=True

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.yourdomain.com

AI_API_KEY=
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_MINUTES=60

# Comma-separated exact origins. Required and load-bearing here: the
# frontend calls this backend directly, cross-site, so without the exact
# Vercel origin(s) listed the browser blocks every request (and "*" is
# rejected by browsers once allow_credentials=True is set, so don't try).
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# The ONLY way an admin account is created -- see app/core/bootstrap.py.
# Set these once on first deploy, then either remove them or leave them
# (re-running with the same email is a no-op once the account exists).
ADMIN_EMAIL=
ADMIN_PASSWORD=

RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
