# ---- Application ----
APP_NAME="Future Gallery"
DEBUG=True
FRONTEND_URL="http://localhost:5173"

# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql+asyncpg://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---- Redis (Upstash) ----
REDIS_URL="rediss://default:password@example.upstash.io:6379"

# ---- Security / JWT ----
SECRET_KEY="change-this-to-a-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
MIN_PASSWORD_LENGTH=8

# ---- Cloudflare Turnstile ----
TURNSTILE_ENABLED=False
TURNSTILE_SECRET=""

# ---- Email ----
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@futuregallery.app"
SMTP_FROM_NAME="Future Gallery"
SMTP_STARTTLS=True

# ---- Supabase Storage (Replaces Cloudflare R2) ----
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="photos"

# ---- AI Feature ----
AI_API_KEY=""

# ---- CORS ----
ALLOWED_ORIGINS="http://localhost:5173"

# ---- Admin Bootstrap ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""