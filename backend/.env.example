# ---- Application ----
APP_NAME="EddyArt Gallery"
DEBUG=True
FRONTEND_URL="http://localhost:5173"

# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql+asyncpg://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---- Redis (Upstash) ----
REDIS_URL="rediss://default:password@example.upstash.io:6379"

# ---- Security / JWT ----
SECRET_KEY="change-this-to-a-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
MIN_PASSWORD_LENGTH=8

# ---- Session cookies ----
# "lax" is correct once the frontend proxies /api/* through to this
# backend (see frontend/vercel.json + vite.config.ts) -- everything looks
# same-origin to the browser at that point. cookie_secure should be True
# in any real (HTTPS) deployment; False is only for plain-http localhost.
cookie_samesite=lax
cookie_secure=False

# ---- Cloudflare Turnstile ----
TURNSTILE_ENABLED=False
TURNSTILE_SECRET=""

# ---- Email ----
# Fill in SMTP_USERNAME/PASSWORD (e.g. from Mailtrap) to actually send --
# emails only log to the console instead of sending when these are unset,
# regardless of DEBUG.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@eddyartgallery.app"
SMTP_FROM_NAME="EddyArt Gallery"
SMTP_STARTTLS=True

# ---- Supabase Storage (Replaces Cloudflare R2) ----
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="photos"

# Video uploads use a SEPARATE bucket from photos (same Supabase project,
# same SUPABASE_URL/SUPABASE_KEY above -- just a second bucket), because
# Supabase enforces file size/type limits per-bucket, not per-request.
# Both buckets are created/updated automatically on backend startup with
# the limits below (see app/core/storage.py's ensure_bucket()) -- you
# only need to set the bucket NAME here, not create it manually first.
SUPABASE_VIDEO_BUCKET="videos"
MAX_PHOTO_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=5242880
MAX_VIDEO_DURATION_SECONDS=8

# ---- Google OAuth2 ("Sign in with Google", customer accounts only) ----
# From Google Cloud Console -> Credentials -> your OAuth client. The
# redirect URI must point at your FRONTEND's domain (proxied through to
# this backend), not this backend's own URL directly -- and must be
# registered exactly as "Authorized redirect URI" in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/api/customer/oauth/google/callback"

# ---- AI Feature (Gemini) ----
# Get an API key from https://aistudio.google.com/apikey . Leave empty to
# keep both AI features off: describe-media 404s, and the chat widget
# (once built) won't render, same "unset -> cleanly disabled" pattern as
# Google OAuth and Turnstile above.
AI_API_KEY=""
# Which Gemini model both AI features call. gemini-3.5-flash is the
# current stable (non-preview) Flash tier as of when this was written --
# see app/core/config.py's AI_MODEL comment for why this is a single
# named setting rather than hardcoded in the AI code, and why NOT to set
# this to a bare "-latest" alias in production.
AI_MODEL="gemini-3.5-flash"
# Shared rate limit budget, one bucket per IP, covering every AI-powered
# endpoint together (describe-media now, chat once built) -- not a
# separate budget per endpoint.
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_MINUTES=60

# ---- CORS ----
# Less load-bearing now that the frontend proxies /api/* (same-origin
# requests aren't subject to CORS at all) -- kept accurate anyway in case
# anything ever calls this backend directly.
ALLOWED_ORIGINS="http://localhost:5173"

# ---- Admin Bootstrap ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
